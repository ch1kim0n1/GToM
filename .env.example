# GToM Configuration

# Service Endpoints
GBRAIN_ENDPOINT=http://localhost:3000

# LLM API Keys (required for real LLM calls)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Vulnerability Thresholds
VULNERABILITY_ALERT_THRESHOLD=0.7
VULNERABILITY_CRITICAL_THRESHOLD=0.9

# Authenticity Thresholds
AUTHENTICITY_MIN_SCORE=0.6
AUTHENTICITY_HIGH_RISK_THRESHOLD=0.3

# ICE Settings
ICE_SENSITIVITY=medium
ICE_ALERT_AUTHORITY=true
ICE_ALERT_SCARCITY=true
ICE_ALERT_SOCIAL_PROOF=true

# Influence Tracking
INFLUENCE_RETENTION_DAYS=30
MAX_INFLUENCES=100

# Logging
LOG_LEVEL=info
